# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=odyssey_tourism

# Weather Service Configuration (Open-Meteo requires no API key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Frontend development origins, comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional OpenAI-compatible endpoint. Deterministic assistant works without these.
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
